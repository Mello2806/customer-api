<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- O "pai" do Spring Boot já define versões compatíveis de todas as bibliotecas -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>br.com.mello</groupId>
    <artifactId>customer-api</artifactId>
    <version>1.0.0</version>

    <properties>
        <java.version>17</java.version>
        <!-- PC com pouca RAM: limita a memória da JVM que roda os testes -->
        <argLine>-Xmx384m -XX:TieredStopAtLevel=1</argLine>
    </properties>

    <dependencies>
        <!-- API REST (servidor web embutido + JSON) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validação com anotações (@NotBlank, @Email, @Valid...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Banco de dados: JPA/Hibernate faz o "meio de campo" entre objetos Java e tabelas -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Reinicia o app sozinho quando o código muda -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Banco em memória só para os testes (não mexe no PostgreSQL de verdade) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Mesmo motivo: limita a memória da API no mvn spring-boot:run -->
                    <jvmArguments>-Xmx384m -XX:TieredStopAtLevel=1</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
